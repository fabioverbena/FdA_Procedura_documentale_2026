{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": ".vercel/output/functions",
    "rootDir": "..",
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "../types.ts"]
}
