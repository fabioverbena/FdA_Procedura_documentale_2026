# ==========================================
# FRONTEND (Vite — lato browser)
# ==========================================
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_SPREADSHEET_ID=your-spreadsheet-id

# ==========================================
# BACKEND (Vercel Serverless — lato server)
# ==========================================

# Token segreto che l'orchestratore Python deve passare come:
#   Authorization: Bearer <API_SECRET_TOKEN>
API_SECRET_TOKEN=cambia-questo-con-un-token-segreto-lungo

# Google Sheets ID (stesso del frontend, senza prefisso VITE_)
SPREADSHEET_ID=your-spreadsheet-id

# Service Account Google (crea in console.cloud.google.com → IAM → Service Accounts)
# 1. Crea service account
# 2. Genera chiave JSON
# 3. Copia email e private_key dal JSON qui sotto
# 4. Condividi il GSheet con l'email del service account (Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=my-service-account@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
